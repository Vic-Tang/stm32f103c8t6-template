{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build_firmware",
      "type": "shell",
      "command": "cmake -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=cmake/arm_none_eabi_gcc.cmake && ninja -C build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "clean_build",
      "type": "shell",
      "command": "rm -rf build",
      "problemMatcher": []
    },
    {
      "label": "flash_openocd",
      "type": "shell",
      "command": "openocd -f interface/stlink.cfg -f target/stm32f1x.cfg -c \"program build/stm32f103c8t6_firmware.elf verify reset exit\"",
      "problemMatcher": []
    },
    {
      "label": "flash_jlink",
      "type": "shell",
      "command": "\"C:/Program Files/SEGGER/JLink/JLink.exe\" -device STM32F103C8 -if SWD -speed 4000 -autoconnect 1 -CommanderScript utils/flash.jlink",
      "problemMatcher": []
    }
  ]
}
