{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (OpenOCD / ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/stm32f103c8t6_firmware.elf",
      "device": "STM32F103C8",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "gdbPath": "C:/msys64/mingw64/bin/gdb-multiarch.exe",
      "armToolchainPath": "C:/msys64/mingw64/bin",
